# Copy to .env.local and fill in real values. .env.local is gitignored (matches *.local).
# (Named env.example without a leading dot because some local tooling blocks writes to
# dotfiles named .env*; rename/copy it to .env.local for local use.)

# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local backend (see kcalma-backend/env.example)
VITE_API_URL=http://localhost:8080
